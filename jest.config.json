{
    "transform": {
        "^.+\\.(t|j)sx?$": ["ts-jest", {
            "tsconfig": "tsconfig.json",
            "diagnostics": {
                "warnOnly": true
            }
        }]
    },
    "testRegex": "(/tests/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
        "ts",
        "tsx",
        "js",
        "jsx",
        "json",
        "node"
    ],
    "moduleNameMapper": {
        "\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["jest-canvas-mock"] 
}
