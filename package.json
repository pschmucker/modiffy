{
  "name": "modiffy",
  "version": "1.4.2",
  "description": "Provides a React component to easily view all meaningful differences between 2 objects",
  "source": "src/index.tsx",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pschmucker/modiffy.git"
  },
  "scripts": {
    "build": "rm -rf .parcel-cache dist && parcel build",
    "build:esm": "tsc --build tsconfig.esm.json",
    "build:cjs": "tsc --build tsconfig.cjs.json",
    "link": "npm run build && npm link --force",
    "lint": "eslint \"{**/*,*}.{js,ts,jsx,tsx}\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "test": "jest",
    "watch": "parcel watch"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "react",
    "typescript",
    "diff",
    "objects",
    "visual",
    "user-friendly",
    "meaningful"
  ],
  "author": "Philippe Schmucker",
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@parcel/packager-ts": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "@parcel/transformer-typescript-types": "2.16.4",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/json-diff": "1.0.3",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "30.5.2",
    "jest-canvas-mock": "2.5.8",
    "jest-environment-jsdom": "30.5.2",
    "parcel": "2.16.4",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "json-diff": "1.0.6",
    "react-i18next": "17.0.15"
  }
}
